{
  "i18n": true,
  "type": "panel",
  "items": {
    "mac": {
      "type": "text",
      "label": "Bluetooth address of the sub",
      "help": "e.g. AA:BB:CC:DD:EE:FF, or use the search button",
      "validator": "/^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/.test(data.mac)",
      "validatorNoSaveOnError": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "scan": {
      "type": "sendTo",
      "command": "scan",
      "label": "Search sub (10 s)",
      "help": "Instance must be running. Disconnect the X-Remote app first.",
      "variant": "contained",
      "useNative": true,
      "showProcess": true,
      "timeout": 45000,
      "jsonData": "{}",
      "result": {
        "found": "Entered and saved: %s\nFound: %s"
      },
      "error": {
        "notFound": "No Nubert device found. Is the sub powered and the X-Remote app disconnected?"
      },
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "hci": {
      "type": "text",
      "label": "Bluetooth adapter (empty = default)",
      "help": "e.g. hci0",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "readbackDelay": {
      "type": "number",
      "min": 5,
      "max": 600,
      "label": "Read status after last command (s)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "idleDisconnect": {
      "type": "number",
      "min": 2,
      "max": 300,
      "label": "Disconnect when idle (s)",
      "help": "The sub allows only one connection; the vendor app can connect after this",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "characteristic": {
      "type": "text",
      "label": "GATT characteristic (experts)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    }
  }
}
